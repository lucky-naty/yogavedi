{% extends '@MauticCore/Default/content.html.twig' %}

{% block mauticContent %}telegramBot{% endblock %}

{% block headerTitle %}Telegram Bots{% endblock %}

{% block actions %}
    <a href="{{ path('mautic_telegram_bots_action', {'objectAction': 'new'}) }}" 
       class="btn btn-primary">
        <i class="ri-add-line"></i> New Bot
    </a>
{% endblock %}

{% block content %}
<div class="panel panel-default">
    <div class="panel-body">
        {% if items is defined and items|length > 0 %}
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Bot Username</th>
                        <th>Webhook</th>
                        <th>Subscribers</th>
                        <th>Tags</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                    <tr>
                        <td><strong>{{ item.name }}</strong><br>
                            <small class="text-muted">{{ item.maskedToken }}</small></td>
                        <td>{% if item.botUsername %}
                                <a href="https://t.me/{{ item.botUsername|replace({'@': ''}) }}" target="_blank">
                                    {{ item.botUsername }}
                                </a>
                            {% else %}—{% endif %}
                        </td>
                        <td>{% if item.webhookRegisteredAt %}
                                <span class="text-success"><i class="ri-check-line"></i> Registered</span><br>
                                <small>{{ item.webhookRegisteredAt|date('d.m.Y H:i') }}</small>
                            {% else %}
                                <span class="text-warning"><i class="ri-alert-line"></i> Not registered</span >
                            {% endif %}
                        </td>
                        {# ИСПОЛЬЗУЕМ ДИНАМИЧЕСКОЕ ПОЛЕ #}
                        <td><span class="badge badge-info">{{ item.dynamicSubscribersCount }}</span></td>
                        <td>{% for tag in item.tagsArray %}
                                <span class="badge badge-secondary">{{ tag }}</span>
                            {% endfor %}
                        </td>
                        <td>{% if item.isPublished %}
                                <span class="label label-success">Active</span>
                            {% else %}
                                <span class="label label-danger">Inactive</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a href="{{ path('mautic_telegram_bots_register_webhook', {id: item.id}) }}"
                                   class="btn btn-info" title="Register webhook"
                                   data-ajax="false"
                                   onclick="window.location.href=this.href; return false;">
                                    <i class="ri-link"></i>
                                </a>
                                <a href="{{ path('mautic_telegram_bots_action', {'objectAction': 'edit', 'objectId': item.id}) }}"
                                   class="btn btn-default"><i class="ri-pencil-line"></i></a>
                                <form method="post" action="{{ path('mautic_telegram_bots_action', {'objectAction': 'delete', 'objectId': item.id}) }}" 
                                      style="display:inline"
                                      onsubmit="return confirm('Delete this bot?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete') }}">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="ri-delete-bin-line"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="text-center py-5">
                <i class="ri-telegram-line" style="font-size: 4rem; color: #0088cc;"></i>
                <h3 class="mt-3">No bots yet</h3>
                <p class="text-muted">Add your first Telegram bot to start collecting subscribers</p>
                <a href="{{ path('mautic_telegram_bots_action', {'objectAction': 'new'}) }}" 
                   class="btn btn-primary mt-2">Add first bot</a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}